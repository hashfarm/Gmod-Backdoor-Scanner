struct LzmaVector {
    const char* name;
    const char* unit;
    int repeat;
    std::vector<uint8_t> compressed;

    std::string Expected() const {
        std::string result;
        for (int i = 0; i < repeat; ++i) result += unit;
        return result;
    }

    std::string Compressed() const {
        return std::string(compressed.begin(), compressed.end());
    }
};

