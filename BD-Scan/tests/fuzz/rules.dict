# libFuzzer dictionary for fuzz_rules: the separators, keywords and attribute
# names the rule, whitelist and composite parsers branch on.

separator=";;;"
comment="#"
severity_critical="[CRITICAL]"
severity_high="[HIGH]"
severity_medium="[MEDIUM]"
severity_low="[LOW]"
id_lua="LUA-001"
id_bin="BIN-014"
id_comp="COMP-001"
id_hash="HASH-001"
id_mod="MOD-001"
id_gma="GMA-001"

attr_tags="tags="
attr_added="added="
attr_ref="ref="
attr_path="path="
attr_scope="scope="

comp_and=" and "
comp_or=" or "
comp_not="not "
comp_atleast="atleast("
comp_open="("
comp_close=")"
comp_comma=","

glob_star="*"
glob_question="?"
glob_dir="*/"
glob_lua="*.lua"
glob_autorun="lua/autorun/*"

re_group="(?:"
re_class="[A-Za-z0-9+/]"
re_posix="[[:alpha:]]"
re_bound="\\b"
re_repeat="{2,400}"
re_star="*"
re_plus="+"
re_nested="(a+)+"
re_escape="\\x"
re_anchor="^"
re_alt="|"

