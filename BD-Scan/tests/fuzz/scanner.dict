# libFuzzer dictionary for fuzz_scanner: tokens the scanner actually branches on.
# Comment and long-bracket syntax, the obfuscation forms that get folded, and
# enough pattern triggers that the fuzzer can reach the detection paths.

comment_line="--"
comment_open="--[["
comment_close="]]"
comment_level_open="--[==["
comment_level_close="]==]"
longstring_open="[["
longstring_level="[=["

concat=" .. "
